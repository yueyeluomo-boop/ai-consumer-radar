<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AI for Fun 全球消费产品周报</title>
  <style>
    :root {
      color-scheme: light;
      --text: #1f2328;
      --muted: #667085;
      --line: #e6e8ec;
      --tag: #f2f4f7;
      --accent: #2563eb;
    }
    body {
      max-width: 880px;
      margin: 40px auto;
      padding: 0 20px 48px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
      line-height: 1.7;
      color: var(--text);
      background: #fff;
    }
    h1, h2, h3 { line-height: 1.3; }
    h1 { margin-bottom: 4px; font-size: 32px; }
    h2 { margin-top: 40px; padding-top: 8px; border-top: 1px solid var(--line); }
    h3 { margin-bottom: 8px; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .meta { color: var(--muted); }
    .item { border-bottom: 1px solid var(--line); padding: 20px 0; }
    .score { font-weight: 700; }
    .tag {
      display: inline-block;
      padding: 2px 8px;
      background: var(--tag);
      border-radius: 999px;
      font-size: 12px;
      color: #344054;
    }
    .empty {
      padding: 20px;
      background: #f8fafc;
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--muted);
    }
  </style>
</head>
<body>
  <h1>AI for Fun 全球消费产品周报</h1>
  <p class="meta">周期：{{ start_date }} - {{ end_date }}</p>

  <h2>一、本周核心判断</h2>
  <ul>
    {% for insight in insights %}
    <li>{{ insight }}</li>
    {% endfor %}
  </ul>

  <h2>二、本周值得体验的产品 / Demo</h2>
  {% if top_items %}
    {% for item in top_items %}
    <div class="item">
      <h3><a href="{{ item.url }}">{{ item.product_name or item.title }}</a></h3>
      <p><span class="tag">{{ item.category }}</span> <span class="score">评分：{{ item.score }}/10</span></p>
      <p><strong>一句话：</strong>{{ item.summary }}</p>
      <p><strong>体验创新：</strong>{{ item.experience_innovation }}</p>
      <p><strong>为什么值得关注：</strong>{{ item.why_it_matters }}</p>
      <p class="meta">来源：{{ item.source_name }}{% if item.published_at %} · {{ item.published_at }}{% endif %}</p>
    </div>
    {% endfor %}
  {% else %}
    <div class="empty">本周期暂无符合阈值的候选。</div>
  {% endif %}

  <h2>三、直播 / 视频 / 社交体验观察</h2>
  {% for obs in observations %}
  <p>{{ obs }}</p>
  {% endfor %}

  <h2>四、下周追踪方向</h2>
  <ul>
    {% for task in next_week %}
    <li>{{ task }}</li>
    {% endfor %}
  </ul>
</body>
</html>
